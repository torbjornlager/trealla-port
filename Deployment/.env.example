# Local smoke-test values. Replace every credential before deployment.
SITE_ADDRESS=http://localhost:8080
PUBLIC_NODE_URL=http://localhost:8080
BROWSER_ORIGIN=http://localhost:8080
PILOT_USER=pilot
# Generate with: docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your password'
PILOT_PASSWORD_HASH='REPLACE_WITH_CADDY_HASH'
# At least 24 random characters. Never commit the real value.
WP_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN

# Optional policy overrides
WP_PROFILE=actor
WP_SANDBOX=whitelist
WP_TIME_LIMIT=10
WP_IDLE_LIMIT=120
WP_MAX_ACTORS=128
WP_MAX_SOLUTIONS=100
WP_MAX_INFLIGHT_CALLS=4
WP_DRAIN_GRACE_SECONDS=10

# Optional host-side bindings (container ports remain 8080, 80, and 443)
PILOT_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
